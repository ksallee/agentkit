__pycache__/
*.pyc
.venv/
.DS_Store

# A person's own layer, never committed. The team layer in .agentkit/ is.
.agentkit/local.*

# Agent worktrees, written by the harness under `.claude/`. `skills/` and
# `commands/` beside them are committed and seeded, so the ignore names the one
# directory. Without it `git status` is never empty while an agent runs, and
# `wrap-up` step 1 reads a dirty tree every session.
.claude/worktrees/

# Generated artboards. `design/capture.py` writes `<Name>.dc.html` and
# `<Name>.classes.html` per screen, and `design/build.py` writes its own
# `.dc.html` sheets beside them plus the `canvas.json` that lays every artboard
# out. `seeds.json` expands `design/` over what is on disk, so one committed
# here reaches every adopting project and collides with that project's next
# run. The generators and `screens.json` stay tracked, which is why the layout
# is named exactly.
design/*.dc.html
design/*.classes.html
design/canvas.json
