#!/usr/bin/env python3
"""Seed the agentkit scaffolding into a project, and record what was written.

    python3 bin/adopt /path/to/project                    # plan, writes nothing
    python3 bin/adopt /path/to/project --write --pack python
    python3 bin/adopt /path/to/project --check            # how far behind, exit 1

Standard library only, so this runs on a machine that has installed nothing
and on any CI runner.

The plan is the default and `--write` is opt-in, because the target is
somebody's repository and not a directory this tool owns. The first run against
a project that already carries these files replaces every one of them and moves
the project's copy aside, which is a change worth reading before it happens.

Four kinds of file, and only the first is ever replaced whole:

- `seeds.json` names what the template owns. Byte copies, hashed into
  `.agentkit/manifest.json`, replaced on every rerun. A path that leaves the
  list is deleted from the project while it still matches its recorded hash.
- `.agentkit/gates.toml`, `team.md` and `phase.json` are the team layer,
  rendered from the answers and seeded once.
- `CLAUDE.md` and `.github/workflows/` are rendered from the answers and
  seeded once.
- `.gitignore` gets a delimited block, rewritten on every run, with every line
  outside it left alone.

A first write ends by running the gate list it seeded, through the project's
own `bin/verify`, and a pack whose gates run pnpm installs first so the check
gate has a `tsc` to resolve. A red gate or a failed install is reported and
leaves this at 0, because the files are written whatever either says.
`--no-gates` skips the install with the run.

`--check` writes nothing and answers a different question: how far the template
has moved since this project adopted it, which of the files it copies changed,
and which of those it has edited. It exits 1 on a project that is behind, so it
can sit in that project's CI.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import shutil
import subprocess
import sys
import time
from collections.abc import Collection
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

TEMPLATE = Path(__file__).resolve().parent.parent

# The seed list is data in the template tree rather than a constant here, so a
# test points `--template` at a fixture carrying its own list and never at the
# real one. A suite coupled to the real tree fails every time a template file
# changes, which trains people to ignore it.
SEEDS = "seeds.json"

# Committed, so both people see the same adoption state. One sha256 per seeded
# file, of the template bytes that were written, which is what makes somebody's
# edit visible on the next run.
MANIFEST_REL = ".agentkit/manifest.json"
MANIFEST_VERSION = 1

TEAM_DIR = ".agentkit"

# The project's router, at the root because an agent loads it from there.
# Rendered from the answers and absent from `seeds.json`, for two
# reasons. This repository's own copy describes agentkit rather than the
# project. And a router carrying a project's rules 1 to 8 is a file the project
# owns, so the manifest never claims its bytes and no rerun replaces them.
ROUTER_REL = "CLAUDE.md"

# What happened to a generated file. `seeded` and `present` overwrite nothing.
# `appended` adds the ignore block to a file the project already had, and it is
# the one merge this tool performs.
SEEDED = "seeded"
PRESENT = "present"
APPENDED = "appended"

# Appended to a target whose bytes nobody here wrote. Measured 2026-08-29 in
# `mac-hours/probes/claude_plugin.py`: a `SKILL.md.local` beside a real
# `SKILL.md` contributes nothing to the skill loader, and a directory holding
# only the sidecar loads no skill at all. A kept edit cannot take effect by
# accident, and it cannot take effect at all until somebody merges it back.
SIDECAR_SUFFIX = ".local"

# Directory noise that is never part of a template. Expanding a directory entry
# picks up whatever is on disk, including whatever the last test run left.
IGNORED_DIRS = ("__pycache__", ".git")
IGNORED_NAMES = (".DS_Store",)
IGNORED_SUFFIXES = (".pyc",)

# The second list in `seeds.json`: real template files a directory entry expands
# over and no project receives. The three ignores above answer whether a file is
# part of any template on any machine, and this answers whether a file that is
# belongs to the project. Keeping them apart is what lets a reader looking for
# why a skill went missing find one list with the reason on it.
TEMPLATE_ONLY = "template_only"

# The third list in `seeds.json`: one file list per language pack, for a file
# only the pack's own toolchain can run. The design capture has to be here:
# reading computed styles needs a browser driver, and the driver a project can
# install is the one its pack already declares. `ruff.toml` and the two
# scaffolding tests are here for the same reason, one gate list further on. A
# gate names the file or nothing does.
#
# Every file named here is subtracted from the directory expansion that would
# otherwise carry it, and the chosen pack's list is added back. A python project
# receives `design/capture.py` and never the node driver beside it, which is
# what keeps a seeded tree free of a script the project cannot run.
#
# A pack's value is a list of template paths, or an object naming the project
# path each one lands at. `_pack_landings` carries the second form and why.
PER_PACK = "per_pack"

# What happened to one file. `unchanged` wrote nothing. `kept` is the only
# status that leaves a second file behind.
#
# `removed` and `orphaned` are the two halves of one case: a path the manifest
# records and `seeds.json` no longer names. Bytes still matching the recorded
# hash are this template's, so they go. Bytes that differ belong to the
# project, so they stay and get named. Reporting both and deleting neither
# leaves an orphan under `.claude/skills/` loading and competing for its
# replacement's triggers until somebody acts on the report.
WRITTEN = "written"
UNCHANGED = "unchanged"
UPDATED = "updated"
KEPT = "kept"
REMOVED = "removed"
ORPHANED = "orphaned"

# The six a `files` row can carry, in the order `report()` counts them, and
# every status this module can print.
#
# `tests/test_skills.py` reads `STATUSES` and asserts each one has a row in the
# outcome table the `adopt` skill carries. It reads this tuple and nothing
# else, so a status added here and left out of it is an omission a reader of
# this file can see. Enumerating the statuses by spelling instead, as the
# module level strings whose name is their own value uppercased, holds only
# while every status happens to be spelled that way and drops the first one
# that is not (#78).
FILE_STATUSES = (WRITTEN, UNCHANGED, UPDATED, KEPT, REMOVED, ORPHANED)
STATUSES = (SEEDED, PRESENT, APPENDED, *FILE_STATUSES)

# The gate lists, one per language, as (name, command, cwd). `adopt` refuses to
# guess this: a gate list that names a command the project does not run makes
# rule 17 disagree with CI, and a rule CI contradicts is worse than an absent
# one. The commands are a starting list the project edits, and nothing here
# checks that they run.
#
# Every language pack declares the style gate, because `seeds.json` now seeds
# `bin/check-style` and every project has prose. `none` stays empty on purpose:
# it is the pack for a project declaring its own list, and `bin/verify` treats
# an empty declaration as a choice rather than a break.
#
# The two python packs declare the probes gate, for the same reason the style
# gate is everywhere: `seeds.json` seeds `bin/check-probes` and, since #71,
# `probes/skill_sources.py`, so both packs have something to check and the
# interpreter to check it with. `typescript` is left out because
# `bin/check-probes` is a Python script and a node project should not take an
# interpreter to run one gate.
#
# A project that drops rule 9 drops this gate with it. `bin/check-probes`
# passes on an empty `probes/` and fails on an absent one with `Drop the probes
# gate, or add probes`, measured 2026-08-30, so the failure names its own
# remedy and the gate list is the team layer's to edit.
#
# The runner splits a command with `shlex` and runs it without a shell, so a
# gate that has to run somewhere else declares `cwd` and never writes `cd x &&`
# into the command. Without the field the runner looks for a binary named `cd`.
PACKS: dict[str, tuple[tuple[str, str, str | None], ...]] = {
    "python": (
        ("style", "bin/check-style .", None),
        ("probes", "bin/check-probes", None),
        ("test", "uv run pytest", None),
        ("lint", "uvx ruff check .", None),
    ),
    "typescript": (
        ("style", "bin/check-style .", None),
        ("check", "pnpm check", None),
        ("test", "pnpm test", None),
    ),
    "python+typescript": (
        ("style", "bin/check-style .", None),
        ("probes", "bin/check-probes", None),
        ("test", "uv run pytest", None),
        ("lint", "uvx ruff check .", None),
        ("web-check", "pnpm check", "web"),
        ("web-test", "pnpm test", "web"),
    ),
    "none": (),
}


@dataclass(frozen=True)
class Outcome:
    """One file's result. `rel` is posix, relative to the project root."""

    rel: str
    status: str
    sidecar: str | None = None


def _sha(payload: bytes) -> str:
    return hashlib.sha256(payload).hexdigest()


def _now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def seeds(template: Path, pack: str = "none") -> list[tuple[str, Path]]:
    """Every seeded file, as (relative path, source path), sorted.

    An entry ending in `/` expands to every file under it, so a skill that
    grows a reference file travels without an edit here, and a file that lands
    on another branch joins the seed list when it lands. Sorting is what makes
    the output and the manifest stable between runs.

    `template_only` subtracts from that expansion. It holds this template's own
    tools, the ones that drive `bin/adopt`, which `seeds.json` keeps out of a
    project by naming the `bin/` entries one by one. A path named on its own
    line in `tracked` is a decision somebody typed and seeds anyway.

    `per_pack` subtracts too, and puts one list back. Every file it names under
    any pack is withheld from the expansion, and the entries under `pack` are
    seeded. That is how a python project gets the Playwright capture and a
    typescript project the Puppeteer one, out of a template holding both.

    A pack's value is a list of template paths, or an object naming where each
    one lands. `python+typescript` runs its pnpm gates in `web/`, so the
    `package.json` this template holds at the root is seeded there, and one
    file serves both packs instead of two copies drifting apart.

    A missing entry raises, on any of the three lists. A seed list naming a file
    nobody wrote is a template that would adopt differently depending on which
    files happened to exist, and an exclusion naming nothing stopped excluding
    whatever it was written for. Failing at that point costs one line in
    `seeds.json`.
    """
    declared = json.loads((template / SEEDS).read_text())
    per_pack = declared.get(PER_PACK, {})
    if per_pack and pack not in per_pack:
        raise SystemExit(f"seeds.json declares {PER_PACK} and names no list for the {pack} pack")
    withheld = [_named(template, entry) for entry in declared.get(TEMPLATE_ONLY, [])]
    withheld += [_named(template, entry) for names in per_pack.values() for entry in names]
    landing = _pack_landings(per_pack, pack)
    found: list[tuple[str, Path]] = []
    for entry in declared["tracked"]:
        source = _named(template, entry)
        if entry.endswith("/"):
            found += [
                (p.relative_to(template).as_posix(), p)
                for p in source.rglob("*")
                if p.is_file() and _carried(p) and not _withheld(p, withheld)
            ]
        else:
            found.append((entry, source))
    found += [(rel, _named(template, entry)) for entry, rel in landing]
    return sorted(found)


def _pack_landings(per_pack: dict, pack: str) -> list[tuple[str, str]]:
    """One pack's entries, as (template path, project path).

    A list seeds each file where the template holds it. An object names the
    project path instead, for a pack whose gates run somewhere else:
    `python+typescript` takes `package.json` to `web/package.json`, off the
    same bytes the `typescript` pack takes to the root.
    """
    entries = per_pack.get(pack, [])
    if isinstance(entries, dict):
        return list(entries.items())
    return [(entry, entry) for entry in entries]


def _named(template: Path, entry: str) -> Path:
    """The template path one `seeds.json` entry names, raising when it is absent."""
    source = template / entry
    if entry.endswith("/"):
        if not source.is_dir():
            raise SystemExit(f"seeds.json names {entry}, which is not a directory in {template}")
    elif not source.is_file():
        raise SystemExit(f"seeds.json names {entry}, which is not a file in {template}")
    return source


def _carried(path: Path) -> bool:
    """Whether an expanded directory entry seeds this file."""
    if any(part in IGNORED_DIRS for part in path.parts):
        return False
    return path.name not in IGNORED_NAMES and path.suffix not in IGNORED_SUFFIXES


def _withheld(path: Path, withheld: Collection[Path]) -> bool:
    """Whether a `template_only` entry covers this file, by name or by directory."""
    return any(path == held or held in path.parents for held in withheld)


def recorded_pack(project: Path) -> str:
    """The language pack the last adoption seeded from, or an empty string.

    The pack decides two things a rerun has to get right: the gate list and the
    workflow, both seeded once, and which capture driver `per_pack` seeds, which
    is replaced on every run. Without a record of it a rerun that omits
    `--pack` would default to `none` and delete a driver the project runs, so
    `main` asks again whenever this comes back empty.
    """
    try:
        loaded = json.loads((project / MANIFEST_REL).read_text())
    except (OSError, ValueError):
        return ""
    pack = loaded.get("pack")
    return pack if isinstance(pack, str) else ""


def manifest(project: Path) -> dict[str, str]:
    """Path to sha256 for every file the last adoption wrote. Empty before the first."""
    try:
        loaded = json.loads((project / MANIFEST_REL).read_text())
    except (OSError, ValueError):
        return {}
    files = loaded.get("files")
    return dict(files) if isinstance(files, dict) else {}


def plan(template: Path, project: Path, pack: str = "none") -> list[Outcome]:
    """What a write would do to each file, changing nothing.

    Four cases come from comparing a seeded target against both the template
    bytes and the recorded hash. A target matching the template is `unchanged`.
    A target matching the manifest is this template's own older copy, so the
    newer version replaces it. A target matching neither was written by
    somebody here, and their copy is kept. A target with no manifest row counts
    as somebody's work, which is why the first run against an existing project
    reports `kept` for every file it collides with.

    The fifth case is a path the manifest records and `seeds.json` no longer
    names. Its file reports `removed` while it still hashes to the recorded
    value and `orphaned` once it differs. A recorded path with nothing left on
    disk is reported nowhere, because there is no file to act on.
    """
    recorded = manifest(project)
    tracked = seeds(template, pack)
    out: list[Outcome] = []
    for rel, src in tracked:
        want = _sha(src.read_bytes())
        target = project / rel
        if not target.is_file():
            out.append(Outcome(rel, WRITTEN))
            continue
        have = _sha(target.read_bytes())
        if have == want:
            out.append(Outcome(rel, UNCHANGED))
        elif have == recorded.get(rel):
            out.append(Outcome(rel, UPDATED))
        else:
            out.append(Outcome(rel, KEPT, rel + SIDECAR_SUFFIX))
    seeded = {rel for rel, _ in tracked}
    for rel, was in sorted(recorded.items()):
        target = project / rel
        if rel in seeded or not target.is_file():
            continue
        out.append(Outcome(rel, REMOVED if _sha(target.read_bytes()) == was else ORPHANED))
    return out


def write(template: Path, project: Path, pack: str = "none") -> list[Outcome]:
    """Seed every tracked file, clear the orphans, and record the hashes.

    Idempotent: a second run over an untouched project writes no file and
    reports every one `unchanged`. The manifest is rewritten either way, so a
    deleted or corrupt one repairs itself on the next run.
    """
    results = plan(template, project, pack)
    # Where each seeded path came from. A `per_pack` object lands a file
    # somewhere other than the template holds it, so the project path is not a
    # template path and rebuilding one from the other reads a file that is not
    # there.
    sources = dict(seeds(template, pack))
    files: dict[str, str] = {}
    gone: set[str] = set()
    for result in results:
        target = project / result.rel
        if result.status == REMOVED:
            target.unlink()
            _prune(project, target.parent)
            gone.add(result.rel)
            continue
        if result.status == ORPHANED:
            # The project owns these bytes now, and `_record` carries the row
            # forward untouched. A run that dropped it would leave the next one
            # unable to tell the file from something the project wrote.
            continue
        source = sources[result.rel]
        payload = source.read_bytes()
        files[result.rel] = _sha(payload)
        if result.status == UNCHANGED:
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        if result.sidecar:
            # The project's most recent version, which replaces any earlier one
            # kept here. Two edits in a row without an adoption between them is
            # the only way that loses anything, and the alternative is a pile of
            # numbered files nobody reads.
            (project / result.sidecar).write_bytes(target.read_bytes())
        target.write_bytes(payload)
        # Mode travels with the bytes. A seeded `bin/verify` that lost its
        # executable bit cannot be run the way `gates.toml` names it, and the
        # failure is a permission error in CI rather than anything readable.
        target.chmod(source.stat().st_mode & 0o777)
    _record(template, project, files, gone, pack)
    return results


def _prune(project: Path, directory: Path) -> None:
    """Delete the empty directories a removed file leaves behind, up to the project root.

    Git tracks no directory, so an empty `.claude/skills/renamed/` shows up in
    nobody's diff and still lists as a skill this template stopped shipping.
    The walk stops at the first directory holding anything.
    """
    while directory != project and directory.is_dir() and not any(directory.iterdir()):
        directory.rmdir()
        directory = directory.parent


def _record(template: Path, project: Path, files: dict[str, str], gone: Collection[str] = (), pack: str = "none") -> Path:
    """Write the manifest, naming where the bytes came from.

    The rows merge onto what the last run recorded. A path `seeds.json` stopped
    naming keeps its row, which is what lets a later run tell its file from one
    the project wrote. `gone` names the rows whose files this run deleted, and
    those go with them.

    The origin is provenance for a reader asking where a project's copy came
    from, and nothing reads it back: a template moved to another directory
    still updates the project it seeded. The commit is read back by `--check`,
    which measures how far the template has moved since. `pack` is read back by
    `recorded_pack`, because a rerun that guessed it would seed the wrong
    capture driver.
    """
    path = project / MANIFEST_REL
    path.parent.mkdir(parents=True, exist_ok=True)
    carried = {rel: sha for rel, sha in manifest(project).items() if rel not in gone}
    body = {
        "version": MANIFEST_VERSION,
        "template": {"origin": str(template), "commit": _commit(template)},
        "written_at": _now(),
        "pack": pack,
        "files": carried | files,
    }
    path.write_text(json.dumps(body, indent=2, sort_keys=True) + "\n")
    return path


def _git(root: Path, *args: str) -> subprocess.CompletedProcess[str] | None:
    """Run git in `root`, or `None` when it could not be run at all.

    A machine with no git and a directory that is no repository are both
    answers this file reports rather than crashes on, so every caller here
    handles a `None` and a non-zero return the same way.
    """
    try:
        return subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None


# Appended to a recorded sha whose checkout had uncommitted changes. The same
# marker `design/capture.py` writes into an artboard stamp, for the same
# reason.
DIRTY = "-dirty"


def _commit(root: Path) -> str:
    """The template's HEAD, marked `-dirty` when the tree has moved off it.

    An adoption copies the working tree, so a clean sha recorded against a
    dirty checkout names a commit whose files the project never received, and
    `git show <sha>:<file>` then disagrees with the seeded copy. A visibly
    untrustworthy sha beats a silently wrong one, and every `--check` answer
    rests on this field.

    Nothing is excluded from the status. `design/capture.py` excludes its own
    output directory because a capture writes there; an adoption writes into
    the project and never into the template, so every change here is a change
    to what the next adoption would seed.
    """
    head = _git(root, "rev-parse", "HEAD")
    if head is None or head.returncode != 0:
        return ""
    status = _git(root, "status", "--porcelain")
    moved = status is not None and status.returncode == 0 and bool(status.stdout.strip())
    return head.stdout.strip() + (DIRTY if moved else "")


# ---------------------------------------------------------------------------
# The drift check, the one thing that reads the recorded commit back


# `--check` exit codes. A project behind its template exits 1, so the flag can
# sit in that project's CI and fail there. Anything that leaves the question
# unanswered exits 2 rather than passing: a directory nobody adopted is not a
# directory that is up to date.
CHECK_LEVEL = 0
CHECK_BEHIND = 1
CHECK_UNANSWERED = 2

# What the report calls each side of the split, in the column `report()` uses
# for a status.
UNEDITED = "unedited"
EDITED = "edited"
DROPPED = "dropped"


def recorded_commit(project: Path) -> str:
    """The template commit the last adoption recorded, or an empty string."""
    try:
        loaded = json.loads((project / MANIFEST_REL).read_text())
    except (OSError, ValueError):
        return ""
    template = loaded.get("template")
    commit = template.get("commit") if isinstance(template, dict) else None
    return commit if isinstance(commit, str) else ""


def _bare(sha: str) -> str:
    """A recorded sha with any `-dirty` marker taken off."""
    return sha[: -len(DIRTY)] if sha.endswith(DIRTY) else sha


def _short(sha: str) -> str:
    """A recorded sha as git abbreviates it, keeping any `-dirty` marker."""
    return _bare(sha)[:7] + (DIRTY if sha.endswith(DIRTY) else "")


def commits_since(template: Path, base: str) -> int | None:
    """How many commits the template has taken since `base`, or `None`.

    `None` says no count describes the distance, and it covers four cases: no
    sha was recorded, git could not run, the template has no history, and
    `base` is not an ancestor of `HEAD`. The last one is what a force push, a
    rebase or a second clone of the same project leaves behind, and counting
    `base..HEAD` across a fork prints a confident number for a distance nobody
    walked.
    """
    base = _bare(base)
    if not base:
        return None
    ancestor = _git(template, "merge-base", "--is-ancestor", base, "HEAD")
    if ancestor is None or ancestor.returncode != 0:
        return None
    counted = _git(template, "rev-list", "--count", f"{base}..HEAD")
    if counted is None or counted.returncode != 0:
        return None
    found = counted.stdout.strip()
    return int(found) if found.isdigit() else None


def drift(template: Path, project: Path, pack: str = "none") -> tuple[list[str], list[str], list[str]]:
    """Which seeded files have moved, as (unedited, edited, dropped).

    A file has moved when the template's bytes today differ from the hash the
    manifest recorded for it, which is the question `--check` asks and a
    different one from what `plan` compares. A file the project edited while
    the template left it alone is drift in neither direction, and `plan` calls
    it `kept` because a rerun would still act on it.

    `edited` means the project's copy differs from what the manifest recorded,
    so a rerun writes the template's bytes and moves the project's to a
    sidecar. A file the project deleted counts as unedited: a rerun writes it
    and there is nothing to keep. `dropped` names a manifest row this template
    no longer seeds, whose file is still on disk.
    """
    recorded = manifest(project)
    tracked = seeds(template, pack)
    unedited: list[str] = []
    edited: list[str] = []
    for rel, src in tracked:
        was = recorded.get(rel)
        if was == _sha(src.read_bytes()):
            continue
        target = project / rel
        if target.is_file() and _sha(target.read_bytes()) != was:
            edited.append(rel)
        else:
            unedited.append(rel)
    seeded = {rel for rel, _ in tracked}
    dropped = [rel for rel in sorted(recorded) if rel not in seeded and (project / rel).is_file()]
    return unedited, edited, dropped


def _headline(was: str, now: str, moved: int | None) -> str:
    """The first line: how far the template has moved, or why that cannot be said."""
    here = f"({_short(now)})" if now else "(agentkit answers no commit of its own)"
    if not was:
        return (
            f"This project's manifest records no template commit {here}, so no count\n"
            "describes the distance. The file list below is the answer."
        )
    if moved is None:
        return (
            f"agentkit has no {_short(was)} in its history {here}. A force push, a rebase or a\n"
            "second clone leaves that, so no count describes the distance. The file list\n"
            "below is the answer."
        )
    if was.endswith(DIRTY):
        return (
            f"agentkit moved {moved} commits since {_short(was)} {here}, and this project was\n"
            "adopted from a checkout carrying uncommitted changes, so that count describes\n"
            "agentkit's history and never what the project received. The file list below is\n"
            "the answer."
        )
    if moved == 0:
        return f"agentkit is at the commit this project adopted {here}."
    return f"agentkit moved {moved} commits since this project adopted it ({_short(was)} -> {_short(now)})."


def check(template: Path, project: Path, pack: str = "none") -> int:
    """Say how far the template has moved since this project adopted it.

    Three answers and an exit code: the distance in commits, which files the
    project copies have changed, and which of those the project has edited
    since. A rerun takes an untouched file whole and moves an edited one to a
    `.local` sidecar, so that split is the part a reader acts on.

    The files are compared against the hashes in the manifest and never against
    the recorded commit, so the list holds when no count can be measured and on
    a machine with no git at all. Which commit changed which file is left out:
    it needs agentkit's history rather than its tree, and the split is what
    decides whether a rerun is safe.

    Exit 1 is the file list and never the commit count. A template that moved
    without touching anything this project copies leaves the project current,
    and a check that failed on it would be a check somebody turns off.
    """
    if not (project / MANIFEST_REL).is_file():
        print(f"{project} carries no {MANIFEST_REL}, so no adoption ever wrote here.")
        print(f"Seed it first:  bin/adopt {project} --write --pack <pack>")
        return CHECK_UNANSWERED

    was = recorded_commit(project)
    print(_headline(was, _commit(template), commits_since(template, was)))
    unedited, edited, dropped = drift(template, project, pack)
    if not unedited and not edited and not dropped:
        print("\nNo file this project copies has changed.")
        return CHECK_LEVEL

    if unedited or edited:
        print(f"\n{len(unedited) + len(edited)} tracked files changed:")
        print(f"  {len(unedited)} you have not edited   -> a rerun takes them")
        print(f"  {len(edited)} you have edited       -> a rerun sidecars yours\n")
        for rel in unedited:
            print(f"  {UNEDITED:<9} {rel}")
        for rel in edited:
            print(f"  {EDITED:<9} {rel}")
    if dropped:
        print(f"\n{len(dropped)} file(s) here are gone from seeds.json:")
        for rel in dropped:
            print(f"  {DROPPED:<9} {rel}")
        print("A rerun deletes each one whose bytes still match the manifest, and names the rest.")
    print(f"\nRerun from the agentkit checkout to take them:\n  bin/adopt {project} --write")
    return CHECK_BEHIND


# ---------------------------------------------------------------------------
# The team layer, which the project owns


# The two settings the design pipeline reads out of the team layer. This
# repository's own `.agentkit/team.md` carries the same table, and #26 is the
# defect that a hand-written file and this renderer both claim one format with
# nothing checking they agree. `tests/test_adopt.py` checks the headings.
#
# `surface` is the only design setting. A `references` row carried two values
# until #123: `curated`, the list `design-references` holds, and `refero`, a
# third-party catalogue. Refero's MCP access is sold on a Pro plan and the
# address the skill named was a marketing page, so the value came out. A
# setting with one legal value is a question with nothing to answer, so the row
# came out with it. #131 is what would bring the row back.
DESIGN_TABLE = (
    "| Setting | Values | Meaning |\n"
    "|---|---|---|\n"
    "| surface | canvas, file, none | where a finished design lands |\n"
)

# What `team_files` renders, for the plan, which has no answers to render
# from. `tests/test_adopt.py` checks the two agree.
TEAM_FILES = ("gates.toml", "phase.json", "team.md")


def team_files(answers: dict[str, str]) -> dict[str, str]:
    """The three team-layer files, rendered from the answers.

    Seeded once and never tracked in the manifest, because these carry the
    project's own decisions the moment somebody edits them. A file the template
    would overwrite is a file two people cannot settle anything in.
    """
    pack = answers["pack"]
    # `command` is the key the runner reads. A gate that names no `cwd` omits the
    # line, so the seeded file carries nothing a reader has to interpret.
    gates = "\n".join(
        f'\n[[gate]]\nname = "{name}"\ncommand = "{command}"\n'
        + (f'cwd = "{cwd}"\n' if cwd else "")
        for name, command, cwd in PACKS[pack]
    )
    return {
        "gates.toml": (
            "# Every gate this project runs, in order. Rule 17 cites this file and\n"
            "# nothing else declares a gate, so the rule text, the runner and CI\n"
            f"# cannot disagree with each other. Seeded from the {pack} pack.\n"
            "#\n"
            "# Nothing checked that these commands run here. Edit the list to match\n"
            "# the project, and CI follows.\n" + gates
        ),
        "phase.json": json.dumps({"version": 1, "phase": answers["phase"]}, indent=2) + "\n",
        "team.md": (
            f"# {answers['name']}\n\n"
            f"{answers['summary']}\n\n"
            "## The layer this file is\n\n"
            "Committed, and it wins over anybody's `.agentkit/local.md` on\n"
            "anything two people have to agree on. One person opting out of the\n"
            "gate list is a decision two people make.\n\n"
            "## Who reviews and who merges\n\n"
            f"{answers['merge']}\n\n"
            "## Who owns what\n\n"
            "One row per area, naming the person who decides when two answers\n"
            "conflict. Unanswered until somebody fills it in.\n\n"
            "| Area | Owner |\n|---|---|\n|  |  |\n\n"
            "## Conventions this project settled\n\n"
            "What a reader would get wrong without being told. Empty is honest\n"
            "until something has actually been settled.\n\n"
            "## Design\n\n" + DESIGN_TABLE + "\n"
            "`surface` waits until somebody picks one.\n"
        ),
    }


def _seed_once(project: Path, where: str, bodies: dict[str, str]) -> list[Outcome]:
    """Write each named file that is absent, and report the rest as present.

    Nothing here is ever replaced and no sidecar appears, so a project's edit
    to any of these survives every rerun. Used by the team layer and by the
    workflows, which are generated from the same answers.
    """
    out: list[Outcome] = []
    for name, text in sorted(bodies.items()):
        target = project / where / name
        rel = f"{where}/{name}"
        if target.is_file():
            out.append(Outcome(rel, PRESENT))
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(text)
        out.append(Outcome(rel, SEEDED))
    return out


def _plan_once(project: Path, where: str, names: tuple[str, ...]) -> list[Outcome]:
    """What `_seed_once` would do to each of `names`, writing nothing."""
    return [
        Outcome(f"{where}/{name}", PRESENT if (project / where / name).is_file() else SEEDED)
        for name in sorted(names)
    ]


def seed_team(project: Path, answers: dict[str, str]) -> list[Outcome]:
    """Write each team-layer file that is absent, and report the rest as present."""
    return _seed_once(project, TEAM_DIR, team_files(answers))


def plan_team(project: Path) -> list[Outcome]:
    """Which team-layer files a write would seed, writing none."""
    return _plan_once(project, TEAM_DIR, TEAM_FILES)


# ---------------------------------------------------------------------------
# The router, the first file an agent loads in the project


# Rendered with `str.format`, so a missing answer raises `KeyError` here rather
# than landing in somebody's tree as a literal `{name}`. Every brace in the
# body below is a substitution; markdown tables carry none.
#
# Rules 0, 9, 20 and 24 are stated in full because a project gets them nowhere
# else: `seeds.json` carries `WORKFLOW.md`, which holds 10 to 19 and 21 to 23
# and says so. That makes this text a second copy of the rule set in this
# repository's own `CLAUDE.md`, and `tests/test_adopt.py` asserts the two
# declare the same rule numbers, so a rule added here without being added there
# fails the suite.
#
# Rules 1 to 8 get a short note and nothing to fill in. The numbers have to
# stay visible, because a router jumping from 0 to 9 reads as a set somebody
# deleted from. Anything more invites an answer: an empty heading invites a
# guess, and a list of the questions invites an agent to answer them on day
# one. The note names `shape`, which asks the operator and rewrites this
# section, so a reader of a seeded router knows what fills it.
ROUTER = """# {name}

{summary}

---

# Rules: every task, every session, human or AI

Breaking one costs two different things. Rules 11, 12, 13, 15, 16, 17, 19 and
24 fail a check: `bin/verify` over `.agentkit/gates.toml`, `bin/check-style`,
and `bin/check-process` over the pull request, its labels and its commits.
Rules 0, 9, 10, 14, 18 and 20 to 23 reach a reader and nothing else, so
skipping one stays invisible until somebody needs what it would have left
behind: the issue that predates the branch, the preference written into the
file that reads it next, the pull request body that says what was verified.

Nothing here compels an agent, and a session that skipped either kind has not
done the work. [`docs/development/WORKFLOW.md`](docs/development/WORKFLOW.md)
names which check reads which rule, and carries the reasoning behind each.

## 0. Read the layers, in order, and let the right one win

Three layers. Precedence is per field.

| Layer | Where | Wins on |
|---|---|---|
| Shipped | `docs/`, `bin/` and `.claude/`, seeded by `adopt` | nothing; it is the default |
| Team | `.agentkit/`, committed | anything two people must agree on |
| Personal | `.agentkit/local.md`, gitignored | taste |

**Team wins on the gate list and the phase.** One person opting out of the test
suite is a decision two people make. **Personal wins on taste**: how work is
delivered, which role guide is read, how large a pull request should be.

`.agentkit/team.md` holds conventions and who owns what. `.agentkit/gates.toml`
declares the gates; `bin/verify` runs them. `.agentkit/phase.json` says
`shaping` or `building`. `.agentkit/local.md` is one person's file, and its
absence means nobody has been asked yet.

## 1 to 8 are yours

Your storage model, your precedence, what this project refuses to build. The
numbers stay open so your rules and the ones below never collide in a citation.

Nothing is written here until somebody settles it. `shape` asks the questions,
files them where the reasoning is kept, and writes the answers back into this
section. A guess here reads as settled to every session after it.

## 9. Probe an external interface, never assume it

Before writing code against a third party library, API or tool, put a small
script in `probes/` that calls the real thing and prints what came back. Commit
it. Payload shapes and field names vary by version, and an assumption baked
into a parser fails quietly on the one machine that matters. A reader reruns a
probe instead of trusting a docstring.

Probes print. They never write to a database. Standard library only, so a probe
runs before the project installs.

This rule applies where the project touches something it does not control. With
no external interface, drop it. A dead rule teaches that rules are decorative.

## 20. Do not widen scope silently

Fold in a bug you hit while working: file it, close it in the same pull
request, say so in the body. The thing to avoid is an unrelated change nobody
can find later. The test: would a reader of the pull request expect it?

## 24. Follow STYLE.md in everything you write

[`docs/development/STYLE.md`](docs/development/STYLE.md) governs markdown,
comments, docstrings, commit messages, issue and pull request bodies. No em
dashes, no "not X, Y", no hedging preambles, no marketing vocabulary.
`bin/check-style .` gates the mechanical half. Voice, restatement and padding
are a reading, and `wrap-up` does it.

## The rest load when they apply

Rules 10 to 19 and 21 to 23 are in
[`docs/development/WORKFLOW.md`](docs/development/WORKFLOW.md): how work is
filed, branched, committed, reviewed and merged. They apply when somebody opens
or files work.

A rule keeps its number wherever it lives, so a citation survives a move.

---

## Read the guide for your role, and skip the other two

{roles}

A guide costs tokens every turn, and two of the three are written for somebody
else. Where two roles disagree, `.agentkit/team.md` says who wins.

Seeding a guide claims no role. The role exists when somebody names it in their
own `.agentkit/local.md`. With no such line, nobody has been asked yet. Ask.

**A role never gates a command.** Every skill is available to everybody, and a
command checks the preconditions it needs and prints the fix when one is
missing. Somebody who came for the schema and now wants a different colour is
doing design for twenty minutes, and a role gate puts a wall exactly there.

## Task knowledge lives in skills

Loaded on demand from `.claude/skills/`, committed, available the moment
somebody clones. No plugin, no install step.

`pick-work`, as `/work`, says what to do next. `wrap-up`, as `/done`, ends a
session: the tree is left clean, the prose gets read against STYLE.md, and
every preference the session stated is written into the file that reads it
next.

Updating this scaffolding runs `bin/adopt` from the agentkit checkout it came
from. That tool, the `adopt` skill driving it and the `/agentkit` command are
seeded nowhere, so this project holds none of the three.

The team layer is data that skills read. Skill precedence doesn't exist: two
skills of one name both load.
"""

# One row per seeded guide, so the router names the files a project actually
# got. `docs/roles/` is a `seeds.json` entry, and a guide added there joins this
# table without an edit here.
ROLES_DIR = "docs/roles"
ROLES_HEADER = "| Role | Guide | Owns |\n|---|---|---|\n"

# What each guide opens by claiming, kept to the phrase the guide itself uses.
# A longer description here would be the copy that drifts.
ROLE_OWNS = {
    "ENGINEER": "the data model, the pipeline, and every number a screen shows",
    "DESIGNER": "the look, the reading order, and the words on screen",
    "OPERATOR": "what the project is for, and the calls only they can make",
}


def role_table(template: Path) -> str:
    """The role table, one row per guide the template seeds.

    A guide with no `ROLE_OWNS` row still gets a row, because a project naming
    the file and describing it as unknown beats a project whose router omits a
    guide sitting in its tree.
    """
    found = sorted((template / ROLES_DIR).glob("*.md")) if (template / ROLES_DIR).is_dir() else []
    if not found:
        return "This project seeds no role guides, so no line selects one."
    rows = "".join(
        f"| {path.stem.capitalize()} | [`{ROLES_DIR}/{path.name}`]({ROLES_DIR}/{path.name}) | "
        f"{ROLE_OWNS.get(path.stem.upper(), 'unstated; read the guide')} |\n"
        for path in found
    )
    return (
        "`.agentkit/local.md` names the role you are working in. Read that guide "
        "and\nskip the others.\n\n" + ROLES_HEADER + rows
    ).rstrip("\n")


def router(template: Path, answers: dict[str, str]) -> str:
    """The project's `CLAUDE.md`, rendered from the answers `adopt` asked for."""
    return ROUTER.format(
        name=answers["name"],
        summary=answers["summary"],
        roles=role_table(template),
    )


def seed_router(template: Path, project: Path, answers: dict[str, str]) -> Outcome:
    """Write the router when the project has none, and touch an existing one never.

    A router is the file a project is most likely to have written itself, and
    the `kept` path would move theirs to `CLAUDE.md.local`, which no agent
    loads. That trades the project's own instructions for this template's on a
    run somebody asked to seed files.

    No policy is picked here on purpose. A delimited block appended to their
    file, a sidecar theirs points at, a merge by hand and moving theirs aside
    are all right for some project, and the answer depends on what their router
    already says. `.claude/skills/adopt/SKILL.md` asks the question and the
    operator answers it. This function reports what it found.
    """
    target = project / ROUTER_REL
    if target.is_file():
        return Outcome(ROUTER_REL, PRESENT)
    target.write_text(router(template, answers))
    return Outcome(ROUTER_REL, SEEDED)


def plan_router(project: Path) -> Outcome:
    """Whether a write would seed the router, writing nothing."""
    return Outcome(ROUTER_REL, PRESENT if (project / ROUTER_REL).is_file() else SEEDED)


# ---------------------------------------------------------------------------
# The workflows, the only thing that runs any of this without a person


# Rendered from the pack and seeded once, and absent from `seeds.json` for a
# reason the router does not share. A tracked file is replaced on the next
# adoption and the project's version moves to a `.local` sidecar. GitHub reads
# no `.local` and nothing outside this directory, so a project that had tuned
# its workflow would find the template's copy running in place of the one it
# wrote, with its edit in a file that runs nowhere.
WORKFLOWS_DIR = ".github/workflows"

# Both workflows check out and install uv whatever the pack declares, because
# `bin/verify` and `bin/check-process` carry a `uv run --script` shebang. A
# project whose gate commands name uv nowhere still needs it on the runner.
CHECKOUT = "      - uses: actions/checkout@v5\n"
SETUP_UV = "      - uses: astral-sh/setup-uv@v7\n        with:\n          enable-cache: true\n"

# node, pnpm, and one install per directory a pnpm gate runs in. A pnpm gate
# fails on a clean runner with no `node_modules`, and the `python+typescript`
# pack runs its two in `web/`, so the install follows the gate's `cwd`.
#
# The versions are a starting point the project edits, the same standing the
# seeded gate commands have: nothing here checked that either matches the
# project. `cache: pnpm` is absent because it needs a lockfile, and a project
# adopted before its first install has none.
SETUP_NODE = (
    "      - uses: actions/setup-node@v5\n"
    "        with:\n"
    "          node-version: lts/*\n"
    "      - uses: pnpm/action-setup@v4\n"
    "        with:\n"
    "          version: 10\n"
)

WORKFLOW_FILES = ("gates.yml", "process.yml")


def pnpm_dirs(pack: str) -> list[str]:
    """Every directory a pnpm gate runs in, `.` for one that names no `cwd`."""
    return sorted({cwd or "." for _, command, cwd in PACKS[pack] if command.split()[0] == "pnpm"})


def toolchain(pack: str) -> str:
    """The steps before `bin/verify`, from what the pack's commands invoke."""
    steps = CHECKOUT + SETUP_UV
    where = pnpm_dirs(pack)
    if where:
        steps += SETUP_NODE
    for directory in where:
        steps += "      - run: pnpm install --frozen-lockfile\n"
        if directory != ".":
            steps += f"        working-directory: {directory}\n"
    return steps


def gates_workflow(pack: str) -> str:
    """`.github/workflows/gates.yml`, which names no gate.

    One step. `bin/verify` reads `.agentkit/gates.toml` and runs everything
    declared there, so a gate added, renamed or removed needs no edit to the
    workflow. A step per gate holds the gate names in a second file, and the
    seeded copy is the one that cannot follow an edit: the project owns its
    gate list, and a template that wrote the workflow once never sees the
    change. A seeded copy of this repository's own four-step file died on step
    two with `No gate named probes`, measured 2026-08-29.

    What a step per gate bought was the gate name in the job's step list.
    `bin/verify` writes its table to the run summary instead.
    """
    return (
        "# Rule 17's gates. `bin/verify` runs everything `.agentkit/gates.toml`\n"
        "# declares, so no gate is named here and changing the gate list needs no\n"
        "# edit to this file.\n"
        "#\n"
        "# One step, and the per-gate result goes to the run summary. A step per gate\n"
        "# holds the gate names in a second file, and this file is seeded once: an\n"
        "# edit to the gate list would leave it naming gates that no longer exist.\n"
        "#\n"
        f"# Seeded from the {pack} pack, and a later adoption leaves it alone. The\n"
        "# steps below install what that pack's commands need on a clean runner. A\n"
        "# gate added later that needs another tool needs a step here.\n"
        "\n"
        "name: Gates\n"
        "\n"
        "on:\n"
        "  pull_request:\n"
        "  push:\n"
        "    branches: [main]\n"
        "\n"
        "concurrency:\n"
        "  group: gates-${{ github.ref }}\n"
        "  cancel-in-progress: true\n"
        "\n"
        "jobs:\n"
        "  gates:\n"
        "    name: Every gate in .agentkit/gates.toml\n"
        "    runs-on: ubuntu-latest\n"
        "    steps:\n" + toolchain(pack) + "      - run: bin/verify\n"
    )


def process_workflow() -> str:
    """`.github/workflows/process.yml`, which reads no pack and no answer.

    Seeded even though `.agentkit/process.toml` is not. Five of the seven
    checks are code and travel unchanged, so they run on the first pull
    request. The other two read the taxonomy, and `bin/check-process` reports
    each one `absent` in the run summary until somebody writes that file. A
    project gets the five it can have, and a line naming what the other two
    need.
    """
    return (
        "# The half of rules 11, 12, 13, 15, 16, 19 and 24 a machine can read, on\n"
        "# every pull request and every push. `bin/check-process` holds all of it, so\n"
        "# this file names no rule text and cannot drift from the checks.\n"
        "#\n"
        "# Two jobs from one file because a pull request and a push carry different\n"
        "# payloads. GitHub skips the one whose event did not fire, and the skipped\n"
        "# job still reports itself in the checks list.\n"
        "#\n"
        "# `edited`, `labeled` and `unlabeled` are in the trigger list because a body\n"
        "# fixed after a failure and a label added after a failure both have to rerun\n"
        "# the job. Without them the only way to clear a red check is an empty commit.\n"
        "#\n"
        "# Two of the seven checks read `.agentkit/process.toml`: the label taxonomy\n"
        "# for rule 15, and the paths rule 19 keeps out of a diff. Nothing seeds that\n"
        "# file, because the area prefix is one project's own answer. Both checks\n"
        "# report `absent` in the run summary until this project writes it, and the\n"
        "# other five run from the first pull request.\n"
        "\n"
        "name: Process\n"
        "\n"
        "on:\n"
        "  pull_request:\n"
        "    types: [opened, edited, reopened, synchronize, labeled, unlabeled]\n"
        "  push:\n"
        "\n"
        "# `issues: read` is the assignee check. `repos/{owner}/{repo}/issues/{n}` is\n"
        "# a different scope from the pull request that closes it, and without this\n"
        "# line the job reports `Could not read #N` on a pull request whose issue is\n"
        "# assigned.\n"
        "permissions:\n"
        "  contents: read\n"
        "  pull-requests: read\n"
        "  issues: read\n"
        "\n"
        "concurrency:\n"
        "  group: process-${{ github.ref }}\n"
        "  cancel-in-progress: true\n"
        "\n"
        "jobs:\n"
        "  pull-request:\n"
        "    name: Rules 11, 13, 15, 16, 19 and 24 over the pull request\n"
        "    if: github.event_name == 'pull_request'\n"
        "    runs-on: ubuntu-latest\n"
        "    steps:\n"
        "      - uses: actions/checkout@v5\n"
        "      - uses: astral-sh/setup-uv@v7\n"
        "        with:\n"
        "          enable-cache: true\n"
        "\n"
        "      # `.agentkit/process.toml` comes from the checkout, so a pull request\n"
        "      # editing the taxonomy is checked against the taxonomy it proposes.\n"
        '      - run: bin/check-process --repo "$GITHUB_REPOSITORY" --pull "$PULL"\n'
        "        env:\n"
        "          GH_TOKEN: ${{ github.token }}\n"
        "          PULL: ${{ github.event.pull_request.number }}\n"
        "\n"
        "  push:\n"
        "    name: Rule 12 over the push\n"
        "    if: github.event_name == 'push'\n"
        "    runs-on: ubuntu-latest\n"
        "    steps:\n"
        "      # Full history, because the check asks git whether the sha the branch\n"
        "      # was at is still reachable from the sha it is at now. A shallow clone\n"
        "      # has neither, and would fail every push instead of the force-pushed\n"
        "      # ones.\n"
        "      - uses: actions/checkout@v5\n"
        "        with:\n"
        "          fetch-depth: 0\n"
        "      - uses: astral-sh/setup-uv@v7\n"
        "        with:\n"
        "          enable-cache: true\n"
        "\n"
        '      - run: bin/check-process --push --before "$BEFORE" --after "$AFTER"\n'
        "        env:\n"
        "          BEFORE: ${{ github.event.before }}\n"
        "          AFTER: ${{ github.event.after }}\n"
    )


def workflow_files(answers: dict[str, str]) -> dict[str, str]:
    """Both workflows, rendered from the answers."""
    return {"gates.yml": gates_workflow(answers["pack"]), "process.yml": process_workflow()}


def seed_workflows(project: Path, answers: dict[str, str]) -> list[Outcome]:
    """Write each workflow that is absent, and report the rest as present."""
    return _seed_once(project, WORKFLOWS_DIR, workflow_files(answers))


def plan_workflows(project: Path) -> list[Outcome]:
    """Which workflows a write would seed, writing none."""
    return _plan_once(project, WORKFLOWS_DIR, WORKFLOW_FILES)


# ---------------------------------------------------------------------------
# The ignore file, the one target where two files merge into one


# Rendered and appended, absent from `seeds.json` for the reason the workflows
# are: a tracked file is replaced whole on the next run, and here that would
# take the project's own ignores with it. Git reads every line of a
# `.gitignore` on its own, so a delimited block sits beside whatever is already
# there and neither half changes what the other means. Every other file
# collision is reported and left to a person.
GITIGNORE_REL = ".gitignore"
GITIGNORE_START = "# agentkit start"
GITIGNORE_END = "# agentkit end"

# Five lines every pack gets, and one a pnpm pack adds. `.agentkit/local.*` is
# what rule 0 requires: it calls the personal layer gitignored, and a project
# seeded without the line commits one person's taste to a shared branch.
# `.claude/worktrees/` is harness state every project running agents produces,
# and without it `git status` reports a dirty tree for as long as an agent is
# working. `skills/` and `commands/` beside it are committed, so the ignore
# names the one directory. The three `design/` lines cover what an artboard run
# writes: `design/capture.py` and `design/build.py` write one `<Name>.dc.html`
# and one `<Name>.classes.html` per screen, and `design/build.py` writes the
# `canvas.json` that lays them out. Those are output, and a project that never
# wanted the file in its index should not depend on a test to find it there.
# The generators and `screens.json` beside them stay tracked, which is why the
# layout is named exactly.
GITIGNORE_LINES = (
    ".agentkit/local.*",
    ".claude/worktrees/",
    "design/*.dc.html",
    "design/*.classes.html",
    "design/canvas.json",
)

# `node_modules/` matches at any depth, so the one line covers the `web/` a
# `python+typescript` project installs into as well as a root install. A first
# write runs `pnpm install` for a pnpm pack, so the directory is there before
# the adopter's first `git status`, and `pnpm-lock.yaml` beside it stays
# tracked because CI installs from it.
GITIGNORE_PNPM_LINES = ("node_modules/",)


def gitignore_block(pack: str = "none") -> str:
    """The delimited block, which every rerun rewrites in place."""
    lines = GITIGNORE_LINES + (GITIGNORE_PNPM_LINES if pnpm_dirs(pack) else ())
    return (
        f"{GITIGNORE_START}\n"
        "# Rewritten by the next adoption. Every line outside the block stays.\n"
        + "".join(f"{line}\n" for line in lines)
        + f"{GITIGNORE_END}\n"
    )


def gitignore(existing: str | None, pack: str = "none") -> tuple[str | None, str]:
    """What the file becomes and what happened, from what is there now.

    A body of `None` means write nothing, and it comes back in two cases. The
    block is already current, or the file opens a block and never closes it.
    The end marker is where a rewrite stops, so a guess at it would delete
    whatever the project wrote below.
    """
    block = gitignore_block(pack)
    if existing is None:
        return block, SEEDED
    start = existing.find(GITIGNORE_START)
    if start < 0:
        head = existing if existing.endswith("\n") or not existing else existing + "\n"
        return head + "\n" + block, APPENDED
    end = existing.find(GITIGNORE_END, start)
    if end < 0:
        return None, KEPT
    after = end + len(GITIGNORE_END)
    if existing[after : after + 1] == "\n":
        after += 1
    rebuilt = existing[:start] + block + existing[after:]
    return (None, UNCHANGED) if rebuilt == existing else (rebuilt, UPDATED)


def seed_gitignore(project: Path, pack: str = "none") -> Outcome:
    """Write or refresh the block, and touch no line the project wrote."""
    target = project / GITIGNORE_REL
    body, status = gitignore(target.read_text() if target.is_file() else None, pack)
    if body is not None:
        target.write_text(body)
    return Outcome(GITIGNORE_REL, status)


def plan_gitignore(project: Path, pack: str = "none") -> Outcome:
    """What a write would do to the ignore file, writing nothing."""
    target = project / GITIGNORE_REL
    existing = target.read_text() if target.is_file() else None
    return Outcome(GITIGNORE_REL, gitignore(existing, pack)[1])


# ---------------------------------------------------------------------------
# The personal skills root, which neither the project nor this repository owns


# A personal skill and a project skill of one name both load, and a typed
# `/name` reaches the personal one. Measured 2026-08-30 on Claude Code 2.1.251,
# recorded on #40: the loaded count went 16 to 17 with no `Skipping duplicate
# skill` line, and `claude -p "/pick-work"` returned the personal copy's
# marker. So a project seeding a name its reader already has ships a skill that
# is unreachable by name on that machine, and the operator running `bin/adopt`
# is the only person who can see both directories.
#
# The run names the collision and continues, which is the standing `kept` has.
# `~/.claude/skills/` is outside the project and outside this repository, and
# reading the directory names is the whole of what happens to it.
SKILLS_REL = ".claude/skills"

# `probes/skill_precedence.py` resolves the loader's roots, honours
# `CLAUDE_CONFIG_DIR`, and reads the `name:` a `SKILL.md` declares over its
# directory name. Reading it from `TEMPLATE` rather than from `--template`
# because the probe is this repository's own tool and no project is seeded with
# it. A second copy of that logic here is the copy that drifts when the loader
# changes.
PROBE_REL = "probes/skill_precedence.py"


def _probe() -> object | None:
    """`probes/skill_precedence.py` as a module, or `None` when it will not load."""
    path = TEMPLATE / PROBE_REL
    if not path.is_file():
        return None
    try:
        spec = importlib.util.spec_from_file_location("skill_precedence", path)
        if spec is None or spec.loader is None:
            return None
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except Exception:
        return None
    return module


def personal_collisions(template: Path) -> tuple[Path | None, list[str]]:
    """The personal skills root, and every name it holds that this template seeds.

    A root of `None` means the probe did not load, so nothing was listed and
    the run says so instead of claiming there is no collision.
    """
    probe = _probe()
    if probe is None:
        return None, []
    tracked = {rel for rel, _ in seeds(template)}
    ours = {
        name
        for name, skill_md in probe.skills_in(template / SKILLS_REL)
        if skill_md.relative_to(template).as_posix() in tracked
    }
    theirs = {name for name, _ in probe.skills_in(probe.user_skills())}
    return probe.user_skills(), sorted(ours & theirs)


# ---------------------------------------------------------------------------
# The command


def default_phase(project: Path) -> str:
    """`building` for a project with a history, `shaping` for one without.

    A four hundred commit repository is not shaping, and a directory with no
    commit in it has no board to pick work from. Both are overridable, and the
    skill asks rather than trusting this.
    """
    try:
        done = subprocess.run(
            ["git", "-C", str(project), "rev-parse", "HEAD"],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return "shaping"
    return "building" if done.returncode == 0 else "shaping"


# The runner a project got from `seeds.json`, named here because the gate run
# below invokes it and nothing else in this file does.
RUNNER_REL = "bin/verify"


def missing_tools(pack: str) -> list[str]:
    """Every binary the seeded gate list names that this machine cannot run.

    `bin/verify` carries a `uv run --script` shebang, so uv is what runs any
    gate at all and it is checked whatever the pack declares. A gate naming
    `bin/x` is seeded beside the runner and needs nothing installed, so only
    the other commands are looked up.
    """
    wanted = ["uv"]
    wanted += [
        command.split()[0]
        for _, command, _ in PACKS[pack]
        if not command.split()[0].startswith("bin/")
    ]
    return sorted({name for name in wanted if shutil.which(name) is None})


def install_pnpm(project: Path, pack: str) -> None:
    """Install what the pnpm gates need, in every directory one of them runs in.

    A pack with no pnpm gate installs nothing. `pnpm_dirs` reads the gate
    list, so the directories are the ones the gates declare and never a second
    copy of them.

    The `check` gate runs `tsc`, which resolves from `node_modules/.bin`, so
    without this it fails on a project with no install and says nothing about
    the project's code. `pnpm dlx tsc --noEmit` in place of an install fails
    identically on clean source and on a real type error, so it can report
    neither. `pnpm test` runs `node --test` and needs no install; one install
    covers both, because both run in the same directory.
    `probes/node_gates.py` prints all four cases.

    A failed install is printed and the gates run anyway. The adoption is
    written whatever either says, and a machine with no network gets the same
    files as one with.
    """
    for where in pnpm_dirs(pack):
        target = project / where
        if not target.is_dir():
            print(f"  no {where}/ to install into, and the gates run anyway")
            continue
        started = time.monotonic()
        done = subprocess.run(
            ["pnpm", "install"],
            cwd=target,
            capture_output=True,
            text=True,
            check=False,
        )
        print(f"  pnpm install  {where}  {time.monotonic() - started:.1f}s")
        if done.returncode:
            print((done.stdout + done.stderr).rstrip())
            print("  The install failed, and the gates run anyway.")


def run_gates(project: Path, pack: str) -> int:
    """Run the gates this adoption seeded and print what they printed.

    A first write ends here, because the gate list, the runner and the files
    the gates read all arrived in the same run and nothing has told the project
    whether they hold together. `bin/verify` is the only thing that reads
    `.agentkit/gates.toml`, so this invokes it and reimplements nothing.

    A red gate leaves this at 0. The adoption is written either way, the
    manifest records it, and an exit code saying otherwise would read as a
    failed write. What a project does about the red gate is the project's.

    An absent toolchain is reported without running anything, and that check
    comes before the install so a machine with no pnpm is named rather than
    crashed into. `uvx ruff` on a machine with no uv exits non-zero from the
    runner, under a gate name, with no line saying the machine is what is
    missing, and a first adoption is exactly when a reader has no basis for
    telling the two apart.

    A pack with pnpm gates installs before the runner. `install_pnpm` carries
    why.
    """
    print(f"\ngates    {project / TEAM_DIR}/gates.toml")
    if not PACKS[pack]:
        print(f"  the {pack} pack declares no gates, so there is nothing to run")
        return 0
    runner = project / RUNNER_REL
    if not runner.is_file():
        print(f"  nothing ran: {RUNNER_REL} is not here")
        return 0
    missing = missing_tools(pack)
    if missing:
        print(f"  nothing ran: this machine has no {', '.join(missing)}")
        print(f"  Install what the pack needs, then run {RUNNER_REL}. The adoption is written.")
        return 0
    install_pnpm(project, pack)
    print()
    # The runner writes to this process's stdout, and a redirected stdout here
    # is block buffered, so without this every line above lands after it.
    sys.stdout.flush()
    done = subprocess.run([str(runner)], cwd=project, check=False)
    if done.returncode:
        print(f"\nThe adoption is written. Rule 17 wants every gate green, and {RUNNER_REL}")
        print("reruns them.")
    return done.returncode


def report(
    project: Path,
    files: list[Outcome],
    team: list[Outcome],
    flows: list[Outcome],
    route: Outcome,
    ignore: Outcome,
    skills: tuple[Path | None, list[str]],
    dry: bool,
) -> None:
    """Name every file and both sides of every kept edit.

    A second file nobody was told about is a file nobody finds, so a kept line
    carries the sidecar name. The summary states the kept count on its own,
    because that is the number a first adoption turns on.
    """
    print(f"\nproject  {project}")
    for row in files:
        line = f"  {row.status:<9} {row.rel}"
        if row.sidecar:
            line += f"   yours kept as {row.sidecar}"
        print(line)
    print(f"\nteam     {project / TEAM_DIR}")
    for row in team:
        print(f"  {row.status:<9} {row.rel}")
    print(f"\nworkflow {project / WORKFLOWS_DIR}")
    for row in flows:
        print(f"  {row.status:<9} {row.rel}")
    print(f"\nignore   {project / GITIGNORE_REL}")
    print(f"  {ignore.status:<9} {ignore.rel}")
    if ignore.status == KEPT:
        print(
            f"\n{GITIGNORE_REL} opens an agentkit block with `{GITIGNORE_START}` and never\n"
            f"closes it with `{GITIGNORE_END}`. Nothing was written: the end marker is\n"
            "where a rewrite stops, and guessing at it would delete the project's own\n"
            "ignores. Put the marker back or delete the opening one, then rerun."
        )

    root, shadowed = skills
    if root is None:
        print(f"\nskills   {PROBE_REL} did not load, so no personal skill was listed.")
    else:
        print(f"\nskills   {root}")
        for name in shadowed:
            print(f"  shadowed  {name}")
        if not shadowed:
            print("  no name seeded here is a personal skill on this machine")

    print(f"\nrouter   {project / ROUTER_REL}")
    print(f"  {route.status:<9} {route.rel}")
    if route.status == PRESENT:
        print(
            f"\n{ROUTER_REL} is already here. Nothing was written, nothing was moved,\n"
            "and no sidecar was made. What a seeded router would have carried:\n"
            "rule 0's three layers, 1 to 8 held open for this project's own\n"
            "constraints, rules 9, 20 and 24 in full, a table naming the role\n"
            "guides, and a pointer to docs/development/WORKFLOW.md for 10 to 23.\n"
            "How the two files end up as one is a question the `adopt` skill asks\n"
            "and the operator answers, per project."
        )

    if shadowed:
        print(
            f"\n{len(shadowed)} skill(s) seeded here share a name with a personal skill in\n"
            f"{root}\n"
            "Both copies load, and a typed name reaches the personal one, so the copy this\n"
            "run writes is unreachable by name on this machine. Measured 2026-08-30 at #40.\n"
            "Rename one, or move the personal copy aside. That directory was read and never\n"
            "written to, and the run continued."
        )

    counts = {status: sum(1 for r in files if r.status == status) for status in FILE_STATUSES}
    print("\n" + "  ".join(f"{n} {status}" for status, n in counts.items()))
    if counts[REMOVED]:
        print(
            f"\n{counts[REMOVED]} file(s) here were seeded by an older template, are gone from\n"
            "seeds.json, and still hash to what the manifest recorded. A write deletes\n"
            "each one, drops its row, and takes any directory it emptied."
        )
    if counts[ORPHANED]:
        print(
            f"\n{counts[ORPHANED]} file(s) here were seeded by an older template, are gone from\n"
            "seeds.json, and have been edited since. Each one stays, because the project\n"
            "owns those bytes. An orphan under .claude/skills/ loads and competes for its\n"
            "replacement's triggers, so merge or delete it by hand."
        )
    if counts[KEPT]:
        print(
            f"\n{counts[KEPT]} file(s) already exist here and differ from the template.\n"
            "A write replaces each one and moves the project's copy to a .local\n"
            "sidecar that nothing loads. On a project older than this template,\n"
            "that is the whole first adoption, and the merge back is by hand."
        )
    if dry:
        print("\nplan only, nothing written. Rerun with --write.")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Seed the agentkit scaffolding into a project.")
    ap.add_argument("project", type=Path, help="The project to adopt into.")
    ap.add_argument("--write", action="store_true", help="Write. Without it this prints the plan and stops.")
    ap.add_argument(
        "--check",
        action="store_true",
        help="Report how far the template has moved since this project adopted it. Exits 1 when it is behind.",
    )
    ap.add_argument("--template", type=Path, default=TEMPLATE, help="The template tree to seed from.")
    ap.add_argument("--pack", choices=sorted(PACKS), help="Which gate list to seed. Required to write the team layer.")
    ap.add_argument("--name", help="The project's name. Defaults to the directory name.")
    ap.add_argument("--summary", default="", help="One line saying what the project is.")
    ap.add_argument("--phase", choices=("shaping", "building"), help="Defaults by whether the target has a commit.")
    ap.add_argument("--merge", default="", help="Who reviews and who merges.")
    ap.add_argument(
        "--no-gates",
        action="store_true",
        help="Skip the gate run a first write ends with, and the install before it.",
    )
    args = ap.parse_args(argv)

    project = args.project.resolve()
    if not project.is_dir():
        print(f"{project} is not a directory.", file=sys.stderr)
        return 2

    # Answered before the pack is demanded, because a project asking how far
    # behind it is has already recorded its pack and is writing nothing.
    if args.check:
        if args.write:
            print("--check writes nothing, so it does not run with --write.", file=sys.stderr)
            return CHECK_UNANSWERED
        return check(args.template, project, args.pack or recorded_pack(project) or "none")

    # The gate list and the gates workflow are both rendered from the pack, and
    # a project adopted before the workflow existed has one and not the other.
    # Asking again is one flag; a workflow rendered from a defaulted `none`
    # installs no pnpm and leaves a typescript project's gates unrunnable.
    # The manifest joins the two files that are rendered from the pack: a
    # project adopted before `per_pack` existed has no record of its own, and a
    # rerun defaulting to `none` would delete the capture driver it runs.
    needs_pack = (
        not (project / TEAM_DIR / "gates.toml").is_file()
        or not (project / WORKFLOWS_DIR / "gates.yml").is_file()
        or not recorded_pack(project)
    )
    if args.write and needs_pack and not args.pack:
        # The one answer that cannot be inferred. Guessing python from a
        # `pyproject.toml` gets a project with a `web/` half wrong, and the
        # wrong gate list is the failure this refuses to risk.
        print("--pack is required the first time, and it is the one answer adopt will not guess.", file=sys.stderr)
        print(f"Choose one of: {', '.join(sorted(PACKS))}", file=sys.stderr)
        return 2

    # A rerun that names no pack takes the one the last adoption recorded, so
    # the driver `per_pack` seeds stays the driver the project installed.
    pack = args.pack or recorded_pack(project) or "none"
    answers = {
        "pack": pack,
        "name": args.name or project.name,
        "summary": args.summary or "Unanswered. One line saying what this project is.",
        "phase": args.phase or default_phase(project),
        "merge": args.merge or "The author does not merge their own pull request.",
    }

    # Read before anything is written, because the write creates the manifest
    # and every later run would look like the first one.
    first_run = not (project / MANIFEST_REL).is_file()

    if args.write:
        files = write(args.template, project, pack)
        team = seed_team(project, answers)
        flows = seed_workflows(project, answers)
        route = seed_router(args.template, project, answers)
        ignore = seed_gitignore(project, pack)
    else:
        files = plan(args.template, project, pack)
        team = plan_team(project)
        flows = plan_workflows(project)
        route = plan_router(project)
        ignore = plan_gitignore(project, pack)
    skills = personal_collisions(args.template)
    report(project, files, team, flows, route, ignore, skills, dry=not args.write)
    if args.write and first_run and not args.no_gates:
        run_gates(project, pack)
    return 0


if __name__ == "__main__":
    sys.exit(main())
